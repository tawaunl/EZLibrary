# Xcode per-user state. NOT `*.xcodeproj` — the iOS app's project bundle has to
# be committed, or the app is invisible to everyone who clones the repo.
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Secrets / credentials — never commit these
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
*.keystore
*.jks
id_rsa
id_ed25519
*.mobileprovision
secrets.*
credentials.json
